<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sms</groupId>
    <artifactId>student-management-system</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Student Management System</name>

    <modules>
        <module>discovery-service</module>
<!--        <module>common-libs</module>-->
        <module>student-service</module>
        <module>teacher-service</module>
        <module>school-service</module>
        <module>parent-service</module>
        <module>course-service</module>
        <module>notification-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring.boot.version>3.5.6</spring.boot.version>
<!--        <cloudwatch2.version>1.14.7</cloudwatch2.version>-->
<!--        <aws.lambda.spring.adapter.version>2.1.5</aws.lambda.spring.adapter.version>-->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- (Optional) If you later add Spring Cloud components, import the Cloud BOM
            <dependency>
              <groupId>org.springframework.cloud</groupId>
              <artifactId>spring-cloud-dependencies</artifactId>
              <version>2025.0.0</version>
              <type>pom</type>
              <scope>import</scope>
            </dependency>
            -->
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <layers enabled="true"/>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
